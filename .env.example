# ─────────────────────────────────────────────────────────────
# NextGen Predict — Environment Variables
# Copy to `.env.local` for local dev. Add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- Supabase (Project Settings → API) -----------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Bypasses Row Level Security. Server-only.
# Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run db:generate` and the Supabase CLI.
SUPABASE_PROJECT_REF=your-project-ref

# --- App -----------------------------------------------------
# Canonical origin. Used for auth email redirects and referral links.
# Local: http://localhost:3000   Prod: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google sign-in ------------------------------------------
# No env vars needed here. Enable it in Supabase instead:
#   1. Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
#      Authorised redirect URI:
#      https://your-project-ref.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Providers → Google: paste the
#      Client ID + Client Secret and enable the provider.
#   3. Supabase → Authentication → URL Configuration: add
#      <NEXT_PUBLIC_SITE_URL>/auth/callback to the redirect allow-list.

# --- Bootstrap admin -----------------------------------------
# Comma-separated emails auto-promoted to `admin` on first sign-in.
# Leave empty after you have promoted your first admin.
ADMIN_BOOTSTRAP_EMAILS=you@example.com

# --- Cron ----------------------------------------------------
# Random secret protecting /api/cron/* (market auto-close job).
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
