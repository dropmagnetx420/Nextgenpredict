{
  "name": "nextgen-predict",
  "version": "1.0.0",
  "private": true,
  "description": "NextGen Predict - Production-ready sports prediction market platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
